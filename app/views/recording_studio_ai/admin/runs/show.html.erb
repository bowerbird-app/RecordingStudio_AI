<div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Run #{@run.id}", subtitle: "#{@run.operation.humanize} · #{@run.created_at.to_fs(:long)}", variant: :h1) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Execution", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %>
      <dl class="grid gap-4 text-sm md:grid-cols-3">
        <div><dt class="opacity-70">Status</dt><dd class="mt-1"><%= render FlatPack::Badge::Component.new(text: @run.status.humanize, style: admin_status_style(@run.status), size: :sm) %></dd></div>
        <div><dt class="opacity-70">Root / context</dt><dd class="mt-1"><%= @run.root_recording_id %> / <%= @run.context_recording_id || "None" %></dd></div>
        <div><dt class="opacity-70">Operation / purpose</dt><dd class="mt-1"><%= @run.operation %> / <%= @run.purpose.presence || "None" %></dd></div>
        <div><dt class="opacity-70">Profile / provider / model</dt><dd class="mt-1"><%= [@run.profile_key, @run.resolved_provider, @run.resolved_model].compact.join(" / ").presence || "Unknown" %></dd></div>
        <div><dt class="opacity-70">Duration</dt><dd class="mt-1"><%= admin_duration(@run.latency_ms) %></dd></div>
        <div><dt class="opacity-70">Usage</dt><dd class="mt-1"><%= admin_tokens(@run.total_tokens) %> tokens</dd></div>
        <div><dt class="opacity-70">Retries / fallbacks / tools</dt><dd class="mt-1"><%= @run.retry_count %> / <%= @run.fallback_count %> / <%= @run.custom_tool_invocation_count %></dd></div>
        <div><dt class="opacity-70">Attachments / citations</dt><dd class="mt-1"><%= @run.attachment_count %> / <%= @run.citation_count %></dd></div>
        <div><dt class="opacity-70">Web search</dt><dd class="mt-1">Requested: <%= @run.web_search_requested? ? "yes" : "no" %>; used: <%= @run.web_search_used? ? "yes" : "no" %></dd></div>
        <div><dt class="opacity-70">Source</dt><dd class="mt-1"><%= @run.execution_source.presence || "Unknown" %></dd></div>
        <% if @sensitive %>
          <div><dt class="opacity-70">Request / job</dt><dd class="mt-1 break-all"><%= [@run.request_id, @run.job_id].compact.join(" / ") %></dd></div>
          <div><dt class="opacity-70">Error</dt><dd class="mt-1"><%= [@run.error_category, @run.error_code, @run.error_message].compact.join(": ").presence || "None" %></dd></div>
          <div class="md:col-span-3"><dt class="opacity-70">Metadata</dt><dd class="mt-1"><pre class="overflow-x-auto whitespace-pre-wrap text-xs"><%= admin_json(@run.metadata) %></pre></dd></div>
        <% end %>
      </dl>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Attempt timeline", subtitle: "Provider attempts in execution order", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %>
      <% if @attempts.any? %><div class="overflow-x-auto"><table class="w-full min-w-max text-left text-sm"><thead><tr class="border-b"><th class="p-3">Sequence / kind</th><th class="p-3">Provider / model</th><th class="p-3">Status</th><th class="p-3">Timing</th><th class="p-3">Usage</th><th class="p-3">Outcome</th></tr></thead><tbody>
        <% @attempts.each do |attempt| %><tr class="border-b align-top"><td class="p-3"><%= attempt.sequence %> / <%= attempt.kind %></td><td class="p-3"><%= [attempt.provider, attempt.model].compact.join(" / ").presence || "Unknown" %></td><td class="p-3"><%= render FlatPack::Badge::Component.new(text: attempt.status.humanize, style: admin_status_style(attempt.status), size: :sm) %></td><td class="p-3"><%= admin_duration(attempt.latency_ms) %><div class="text-xs opacity-70"><%= [attempt.started_at, attempt.completed_at].map { |time| time&.to_fs(:long) || "Unknown" }.join(" / ") %></div></td><td class="p-3"><%= admin_tokens(attempt.total_tokens) %></td><td class="p-3"><%= attempt.finish_reason.presence || "Unknown" %><% if attempt.error_code.present? %><div class="text-xs"><%= [attempt.error_category, attempt.error_code, attempt.error_message].compact.join(": ") %></div><% end %></td></tr><% end %>
      </tbody></table></div><% else %><p class="text-sm opacity-70">No attempts were recorded.</p><% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Custom-tool timeline", subtitle: "Definitions and sanitized execution summaries only", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %>
      <% if @tool_invocations.any? %><div class="overflow-x-auto"><table class="w-full min-w-max text-left text-sm"><thead><tr class="border-b"><th class="p-3">Tool</th><th class="p-3">Status / safety</th><th class="p-3">Confirmation</th><th class="p-3">Timing</th><th class="p-3">Summary</th></tr></thead><tbody>
        <% @tool_invocations.each do |invocation| %><tr class="border-b align-top"><td class="p-3"><%= link_to "#{invocation.tool_key} v#{invocation.tool_version}", version_admin_custom_tool_path(invocation.tool_key, invocation.tool_version) %><div class="text-xs opacity-70"><%= invocation.tool_name_snapshot %></div></td><td class="p-3"><%= render FlatPack::Badge::Component.new(text: invocation.status.humanize, style: admin_status_style(invocation.status), size: :sm) %><div class="text-xs opacity-70"><%= invocation.read_only? ? "Read only" : "Writes" %><%= ", destructive" if invocation.destructive? %>; confirmation <%= invocation.requires_confirmation? ? "required" : "not required" %>; <%= invocation.idempotent? ? "idempotent" : "non-idempotent" %>; <%= invocation.latency_category.presence || "Unclassified" %></div></td><td class="p-3"><%= invocation.confirmation_status.presence || "Not required" %></td><td class="p-3"><%= admin_duration(invocation.latency_ms) %></td><td class="p-3"><% if @sensitive %><%= invocation.result_summary.presence || "No summary" %><% else %>Restricted<% end %></td></tr><% end %>
      </tbody></table></div><% else %><p class="text-sm opacity-70">No custom tools were invoked.</p><% end %>
    <% end %>
  <% end %>
</div>
