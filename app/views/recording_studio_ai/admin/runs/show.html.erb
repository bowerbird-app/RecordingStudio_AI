<div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Run #{@run.id}", subtitle: "#{@run.operation.humanize} · #{@run.created_at.to_fs(:long)}", variant: :h1) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Execution", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %>
      <dl class="grid gap-4 text-sm md:grid-cols-3">
        <div><dt class="opacity-70">Status</dt><dd class="mt-1"><%= render FlatPack::Badge::Component.new(text: @run.status.humanize, style: admin_status_style(@run.status), size: :sm) %></dd></div>
        <div><dt class="opacity-70">Root / context</dt><dd class="mt-1"><%= @run.root_recording_id %> / <%= @run.context_recording_id || "None" %></dd></div>
        <div><dt class="opacity-70">Operation / purpose</dt><dd class="mt-1"><%= @run.operation %> / <%= @run.purpose.presence || "None" %></dd></div>
        <div><dt class="opacity-70">Profile / provider / model</dt><dd class="mt-1"><%= [@run.profile_key, @run.resolved_provider, @run.resolved_model].compact.join(" / ").presence || "Unknown" %></dd></div>
        <div><dt class="opacity-70">Duration</dt><dd class="mt-1"><%= admin_duration(@run.latency_ms) %></dd></div>
        <div><dt class="opacity-70">Usage</dt><dd class="mt-1"><%= admin_tokens(@run.total_tokens) %> tokens</dd></div>
        <div><dt class="opacity-70">Retries / fallbacks / tools</dt><dd class="mt-1"><%= @run.retry_count %> / <%= @run.fallback_count %> / <%= @run.custom_tool_invocation_count %></dd></div>
        <div><dt class="opacity-70">Attachments / citations</dt><dd class="mt-1"><%= @run.attachment_count %> / <%= @run.citation_count %></dd></div>
        <div><dt class="opacity-70">Web search</dt><dd class="mt-1">Requested: <%= @run.web_search_requested? ? "yes" : "no" %>; used: <%= @run.web_search_used? ? "yes" : "no" %></dd></div>
        <div><dt class="opacity-70">Source</dt><dd class="mt-1"><%= @run.execution_source.presence || "Unknown" %></dd></div>
        <% if @sensitive %>
          <div><dt class="opacity-70">Request / job</dt><dd class="mt-1 break-all"><%= [@run.request_id, @run.job_id].compact.join(" / ") %></dd></div>
          <div><dt class="opacity-70">Error</dt><dd class="mt-1"><%= [@run.error_category, @run.error_code, @run.error_message].compact.join(": ").presence || "None" %></dd></div>
          <div class="md:col-span-3">
            <dt class="opacity-70">Metadata</dt>
            <dd class="mt-1"><%= admin_code_block(admin_json(@run.metadata), title: "Metadata", language: "json") %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Attempt timeline", subtitle: "Provider attempts in execution order", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %>
      <% if @attempts.any? %>
        <%= render FlatPack::Table::Component.new(data: @attempts) do |table| %>
          <% table.column(title: "Sequence / kind", html: ->(attempt) { "#{attempt.sequence} / #{attempt.kind}" }) %>
          <% table.column(title: "Provider / model", html: ->(attempt) { [attempt.provider, attempt.model].compact.join(" / ").presence || "Unknown" }) %>
          <% table.column(
            title: "Status",
            html: ->(attempt) { render FlatPack::Badge::Component.new(text: attempt.status.humanize, style: admin_status_style(attempt.status), size: :sm) }
          ) %>
          <% table.column(
            title: "Timing",
            html: ->(attempt) {
              safe_join([
                admin_duration(attempt.latency_ms),
                content_tag(:div, [attempt.started_at, attempt.completed_at].map { |time| time&.to_fs(:long) || "Unknown" }.join(" / "), class: "text-xs opacity-70")
              ])
            }
          ) %>
          <% table.column(title: "Usage", html: ->(attempt) { admin_tokens(attempt.total_tokens) }) %>
          <% table.column(
            title: "Outcome",
            html: ->(attempt) {
              error_line = attempt.error_code.present? ? content_tag(:div, [attempt.error_category, attempt.error_code, attempt.error_message].compact.join(": "), class: "text-xs") : nil
              safe_join([attempt.finish_reason.presence || "Unknown", error_line].compact)
            }
          ) %>
        <% end %>
      <% else %>
        <p class="text-sm opacity-70">No attempts were recorded.</p>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Custom-tool timeline", subtitle: "Definitions and sanitized execution summaries only", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %>
      <% if @tool_invocations.any? %>
        <%= render FlatPack::Table::Component.new(data: @tool_invocations) do |table| %>
          <% table.column(
            title: "Tool",
            html: ->(invocation) {
              safe_join([
                content_tag(:span, "#{invocation.tool_key} v#{invocation.tool_version}", class: "font-semibold"),
                content_tag(:div, invocation.tool_name_snapshot, class: "text-xs opacity-70")
              ])
            }
          ) %>
          <% table.column(
            title: "Status / safety",
            html: ->(invocation) {
              safety = "#{invocation.read_only? ? 'Read only' : 'Writes'}#{', destructive' if invocation.destructive?}; confirmation #{invocation.requires_confirmation? ? 'required' : 'not required'}; #{invocation.idempotent? ? 'idempotent' : 'non-idempotent'}; #{invocation.latency_category.presence || 'Unclassified'}"
              safe_join([
                render(FlatPack::Badge::Component.new(text: invocation.status.humanize, style: admin_status_style(invocation.status), size: :sm)),
                content_tag(:div, safety, class: "text-xs opacity-70")
              ])
            }
          ) %>
          <% table.column(title: "Confirmation", html: ->(invocation) { invocation.confirmation_status.presence || "Not required" }) %>
          <% table.column(title: "Timing", html: ->(invocation) { admin_duration(invocation.latency_ms) }) %>
          <% table.column(title: "Summary", html: ->(invocation) { @sensitive ? (invocation.result_summary.presence || "No summary") : "Restricted" }) %>
        <% end %>
      <% else %>
        <p class="text-sm opacity-70">No custom tools were invoked.</p>
      <% end %>
    <% end %>
  <% end %>
</div>
