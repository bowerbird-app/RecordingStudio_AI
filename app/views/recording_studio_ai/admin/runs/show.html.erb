<div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Run #{@run.id}", subtitle: "#{@run.operation.humanize} · #{@run.created_at.to_fs(:long)}", variant: :h1) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Execution", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %>
      <dl class="grid gap-4 text-sm md:grid-cols-3">
        <div><dt class="opacity-70">Status</dt><dd class="mt-1"><%= render FlatPack::Badge::Component.new(text: @run.status.humanize, style: admin_status_style(@run.status), size: :sm) %></dd></div>
        <div><dt class="opacity-70">Root / context</dt><dd class="mt-1"><%= @run.root_recording_id %> / <%= @run.context_recording_id || "None" %></dd></div>
        <div><dt class="opacity-70">Operation / purpose</dt><dd class="mt-1"><%= @run.operation %> / <%= @run.purpose.presence || "None" %></dd></div>
        <div><dt class="opacity-70">Profile / provider / model</dt><dd class="mt-1"><%= [@run.profile_key, @run.resolved_provider, @run.resolved_model].compact.join(" / ").presence || "Unknown" %></dd></div>
        <div><dt class="opacity-70">Duration</dt><dd class="mt-1"><%= admin_duration(@run.latency_ms) %></dd></div>
        <div><dt class="opacity-70">Started / completed</dt><dd class="mt-1"><%= [@run.started_at, @run.completed_at].map { |time| time&.to_fs(:long) || "Unknown" }.join(" / ") %></dd></div>
        <div><dt class="opacity-70">Usage / cost</dt><dd class="mt-1"><%= admin_tokens(@run.total_tokens) %> tokens / <%= admin_cost(@run.cost_amount_microunits, @run.cost_currency, @run.cost_estimated) %></dd></div>
        <div><dt class="opacity-70">Retries / fallbacks / tools</dt><dd class="mt-1"><%= @run.retry_count %> / <%= @run.fallback_count %> / <%= @run.custom_tool_invocation_count %></dd></div>
        <div><dt class="opacity-70">Attachments / citations</dt><dd class="mt-1"><%= @run.attachment_count %> / <%= @run.citation_count %></dd></div>
        <div><dt class="opacity-70">Attachment bytes / content types</dt><dd class="mt-1"><%= number_with_delimiter(@run.attachment_total_bytes) %> / <%= Array(@run.attachment_content_types).join(", ").presence || "None" %></dd></div>
        <div><dt class="opacity-70">Web search</dt><dd class="mt-1">Requested: <%= @run.web_search_requested? ? "yes" : "no" %>; used: <%= @run.web_search_used? ? "yes" : "no" %></dd></div>
        <div><dt class="opacity-70">Initiator</dt><dd class="mt-1"><%= admin_identity(@run.initiator_type, @run.initiator_id) %></dd></div>
        <div><dt class="opacity-70">Executor</dt><dd class="mt-1"><%= admin_identity(@run.executor_type, @run.executor_id) %></dd></div>
        <div><dt class="opacity-70">Impersonator</dt><dd class="mt-1"><%= admin_identity(@run.impersonator_type, @run.impersonator_id) %></dd></div>
        <div><dt class="opacity-70">Source</dt><dd class="mt-1"><%= @run.execution_source.presence || "Unknown" %></dd></div>
        <div class="md:col-span-3"><dt class="opacity-70">Metadata</dt><dd class="mt-1"><pre class="overflow-x-auto whitespace-pre-wrap text-xs"><%= admin_json(@run.metadata) %></pre></dd></div>
        <% if @sensitive %>
          <div><dt class="opacity-70">Request / job</dt><dd class="mt-1 break-all"><%= [@run.request_id, @run.job_id].compact.join(" / ") %></dd></div>
          <div><dt class="opacity-70">Error</dt><dd class="mt-1"><%= [@run.error_category, @run.error_code, @run.error_message].compact.join(": ").presence || "None" %></dd></div>
        <% end %>
      </dl>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Attempt timeline", subtitle: "Provider attempts in execution order", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %>
      <% if @attempts.any? %><div class="overflow-x-auto"><table class="w-full min-w-max text-left text-sm"><thead><tr class="border-b"><th class="p-3">Sequence / kind</th><th class="p-3">Provider / model</th><th class="p-3">Status</th><th class="p-3">Timing</th><th class="p-3">Usage / cost</th><th class="p-3">Attachments / search / outcome</th><th class="p-3">Metadata</th><th class="p-3">Response</th></tr></thead><tbody>
        <% @attempts.each do |attempt| %><tr class="border-b align-top"><td class="p-3"><%= attempt.sequence %> / <%= attempt.kind %></td><td class="p-3"><%= [attempt.provider, attempt.model].compact.join(" / ").presence || "Unknown" %><% if @sensitive && attempt.provider_request_id.present? %><div class="text-xs opacity-70"><%= attempt.provider_request_id %></div><% end %></td><td class="p-3"><%= render FlatPack::Badge::Component.new(text: attempt.status.humanize, style: admin_status_style(attempt.status), size: :sm) %></td><td class="p-3"><%= admin_duration(attempt.latency_ms) %><div class="text-xs opacity-70"><%= attempt.streaming? ? "Streaming" : "Synchronous" %></div><div class="text-xs opacity-70"><%= [attempt.started_at, attempt.completed_at].map { |time| time&.to_fs(:long) || "Unknown" }.join(" / ") %></div></td><td class="p-3"><%= admin_tokens(attempt.total_tokens) %> / <%= admin_cost(attempt.cost_amount_microunits, attempt.cost_currency, attempt.cost_estimated) %></td><td class="p-3"><%= attempt.finish_reason.presence || "Unknown" %><div class="text-xs opacity-70"><%= attempt.attachment_count %> attachments; <%= number_with_delimiter(attempt.attachment_total_bytes) %> bytes; <%= Array(attempt.attachment_content_types).join(", ").presence || "no content types" %>; <%= attempt.provider_file_count.nil? ? "unknown" : attempt.provider_file_count %> provider files</div><div class="text-xs opacity-70">Search requested: <%= attempt.web_search_requested? ? "yes" : "no" %>; used: <%= attempt.web_search_used? ? "yes" : "no" %>; <%= attempt.citation_count %> citations</div><% if attempt.error_code.present? %><div class="text-xs"><%= [attempt.error_category, attempt.error_code, attempt.error_message].compact.join(": ") %></div><% end %></td><td class="p-3"><pre class="max-w-xs whitespace-pre-wrap text-xs"><%= admin_json(attempt.metadata) %></pre></td><td class="p-3"><% if attempt.response.nil? %>Response content was not retained for this execution.<% elsif @sensitive %><%= link_to "View retained response", admin_retained_response_path(attempt.response) %><% else %>Retained response is restricted.<% end %></td></tr><% end %>
        </tbody></table></div><% else %><p class="text-sm opacity-70">No attempts were recorded.</p><% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Custom-tool timeline", subtitle: "Definitions and sanitized execution summaries only", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %>
      <% if @tool_invocations.any? %><div class="overflow-x-auto"><table class="w-full min-w-max text-left text-sm"><thead><tr class="border-b"><th class="p-3">Tool</th><th class="p-3">Attempts</th><th class="p-3">Status / safety</th><th class="p-3">Confirmation</th><th class="p-3">Timing</th><th class="p-3">Summary</th><th class="p-3">Metadata / error</th></tr></thead><tbody>
        <% @tool_invocations.each do |invocation| %><tr class="border-b align-top"><td class="p-3"><%= link_to "#{invocation.tool_key} v#{invocation.tool_version}", version_admin_custom_tool_path(invocation.tool_key, invocation.tool_version) %><div class="text-xs opacity-70"><%= invocation.tool_name_snapshot %></div></td><td class="p-3"><%= invocation.requested_by_attempt_id || "None" %> → <%= invocation.continued_by_attempt_id || "None" %></td><td class="p-3"><%= render FlatPack::Badge::Component.new(text: invocation.status.humanize, style: admin_status_style(invocation.status), size: :sm) %><div class="text-xs opacity-70"><%= invocation.read_only? ? "Read only" : "Writes" %><%= ", destructive" if invocation.destructive? %>; confirmation <%= invocation.requires_confirmation? ? "required" : "not required" %>; <%= invocation.idempotent? ? "idempotent" : "non-idempotent" %>; <%= [invocation.cost_category, invocation.latency_category].compact.join(" / ").presence || "Unclassified" %></div></td><td class="p-3"><%= invocation.confirmation_status.presence || "Not required" %><% if @sensitive && invocation.confirmed_by_id.present? %><div class="text-xs opacity-70"><%= admin_identity(invocation.confirmed_by_type, invocation.confirmed_by_id) %> / <%= invocation.confirmed_at&.to_fs(:long) %></div><% end %></td><td class="p-3"><%= admin_duration(invocation.latency_ms) %><div class="text-xs opacity-70"><%= [invocation.started_at, invocation.completed_at].map { |time| time&.to_fs(:long) || "Unknown" }.join(" / ") %></div></td><td class="p-3"><% if @sensitive %><div class="text-xs opacity-70"><%= invocation.result_summary.presence || "No summary" %></div><% else %>Restricted<% end %></td><td class="p-3"><pre class="max-w-xs whitespace-pre-wrap text-xs"><%= admin_json(invocation.metadata) %></pre><% if invocation.error_code.present? %><div class="text-xs"><%= [invocation.error_category, invocation.error_code, invocation.error_message].compact.join(": ") %></div><% end %></td></tr><% end %>
        </tbody></table></div><% else %><p class="text-sm opacity-70">No custom tools were invoked.</p><% end %>
    <% end %>
  <% end %>
</div>
