<div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "AI runs", subtitle: "Review recorded AI execution runs.") %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <% if @runs.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-max text-left text-sm">
            <thead>
              <tr class="border-b">
                <th class="p-3">Time / ID</th>
                <th class="p-3">Attribution</th>
                <th class="p-3">Operation</th>
                <th class="p-3">Provider / model</th>
                <th class="p-3">Status</th>
                <th class="p-3">Duration</th>
                <th class="p-3">Tokens / cost</th>
                <th class="p-3">Activity</th>
                <th class="p-3">Source</th>
              </tr>
            </thead>
            <tbody>
              <% @runs.each do |run| %>
                <tr class="border-b align-top">
                  <td class="p-3">
                    <%= link_to run.created_at.to_fs(:short), admin_run_path(run), class: "font-semibold" %>
                    <div class="mt-1 text-xs opacity-70">Run <%= run.id %></div>
                  </td>
                  <td class="p-3">
                    Root <%= run.root_recording_id %>
                    <% if @sensitive_roots[run.root_recording_id] %>
                      <div class="text-xs opacity-70">
                        Context <%= run.context_recording_id || "none" %><br>
                        Initiator <%= [run.initiator_type, run.initiator_id].compact.join(" ") %><br>
                        Executor <%= [run.executor_type, run.executor_id].compact.join(" ").presence || "none" %>
                      </div>
                    <% end %>
                  </td>
                  <td class="p-3"><%= run.operation %><div class="text-xs opacity-70"><%= run.purpose.presence || "No purpose" %> / <%= run.profile_key.presence || "No profile" %></div></td>
                  <td class="p-3"><%= [run.resolved_provider, run.resolved_model].compact.join(" / ").presence || "Unknown" %></td>
                  <td class="p-3"><%= render FlatPack::Badge::Component.new(text: run.status.humanize, style: admin_status_style(run.status), size: :sm) %></td>
                  <td class="p-3"><%= admin_duration(run.latency_ms) %></td>
                  <td class="p-3"><%= admin_tokens(run.input_tokens) %> / <%= admin_tokens(run.output_tokens) %> / <%= admin_tokens(run.total_tokens) %><div class="text-xs opacity-70">Input / output / total</div><div class="text-xs opacity-70"><%= admin_cost(run.cost_amount_microunits, run.cost_currency, run.cost_estimated) %></div></td>
                  <td class="p-3"><%= run.attempt_count %> attempts / <%= run.retry_count %> retries / <%= run.fallback_count %> fallbacks<br><%= run.custom_tool_invocation_count %> tools / <%= run.attachment_count %> attachments<div class="text-xs opacity-70"><%= run.citation_count %> citations / search <%= run.web_search_requested? ? "requested" : "not requested" %>, <%= run.web_search_used? ? "used" : "not used" %></div></td>
                  <td class="p-3"><%= run.execution_source.presence || "Unknown" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <%= render FlatPack::EmptyState::Component.new(title: "No runs found", description: "Adjust the filters or wait for new AI activity.") %>
      <% end %>
    <% end %>
  <% end %>
</div>
