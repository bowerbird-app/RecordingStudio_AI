<div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Provider-native tools", subtitle: "Web-search reporting uses only provider-reported usage and citations; internal search counts are never inferred.", variant: :h1) %>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% { "Runs requested" => @runs.count, "Attempts requested" => @attempts.count, "Reported citations" => @citation_count, "Average duration" => admin_duration(@average_latency&.round), "Known cost" => admin_cost(@cost_microunits, @cost_currency) }.each do |label, value| %><%= render FlatPack::Card::Component.new(style: :default) do |card| %><% card.body do %><p class="text-sm opacity-70"><%= label %></p><p class="mt-2 text-xl font-bold"><%= value %></p><% end %><% end %><% end %>
  </div>

  <div class="grid gap-6 lg:grid-cols-3">
    <% { "Providers" => @providers, "Models" => @models, "Outcomes" => @outcomes }.each do |title, values| %><%= render FlatPack::Card::Component.new(style: :default) do |card| %><% card.header do %><%= render FlatPack::PageTitle::Component.new(title: title, variant: :h3, class: "mb-0 pb-0") %><% end %><% card.body do %><dl class="space-y-2 text-sm"><% values.each do |key, count| %><div class="flex justify-between gap-4"><dt><%= key.presence || "Unknown" %></dt><dd class="font-semibold"><%= count %></dd></div><% end %></dl><% end %><% end %><% end %>
  </div>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Recent web-search runs", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %><% if @runs.any? %><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr class="border-b"><th class="p-3">Run</th><th class="p-3">Provider / model</th><th class="p-3">Status</th><th class="p-3">Used</th><th class="p-3">Citations</th><th class="p-3">Duration</th><th class="p-3">Cost</th></tr></thead><tbody><% @runs.each do |run| %><tr class="border-b"><td class="p-3"><%= link_to run.id, admin_run_path(run) %></td><td class="p-3"><%= [run.resolved_provider, run.resolved_model].compact.join(" / ") %></td><td class="p-3"><%= render FlatPack::Badge::Component.new(text: run.status.humanize, style: admin_status_style(run.status), size: :sm) %></td><td class="p-3"><%= run.web_search_used? ? "Yes" : "No" %></td><td class="p-3"><%= run.citation_count %></td><td class="p-3"><%= admin_duration(run.latency_ms) %></td><td class="p-3"><%= admin_cost(run.cost_amount_microunits, run.cost_currency, run.cost_estimated) %></td></tr><% end %></tbody></table></div><% else %><%= render FlatPack::EmptyState::Component.new(title: "No web-search activity", description: "Runs that request provider-native web search will appear here.") %><% end %><% end %>
  <% end %>
</div>
