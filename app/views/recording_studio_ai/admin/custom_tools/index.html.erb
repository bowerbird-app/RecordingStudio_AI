<div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Custom tools", subtitle: "Registered definitions combined with invocation aggregates from visible roots.", variant: :h1) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <% if @definitions.any? %>
        <%= render FlatPack::Table::Component.new(data: @definitions) do |table| %>
          <% table.column(
            title: "Tool",
            html: ->(definition) {
              safe_join([
                content_tag(:span, "#{definition.name} v#{definition.version}", class: "font-semibold"),
                content_tag(:div, definition.key, class: "text-xs opacity-70")
              ])
            }
          ) %>
          <% table.column(title: "Description", html: ->(definition) { definition.description }) %>
          <% table.column(title: "Cost / latency", html: ->(definition) { "#{definition.cost} / #{definition.latency}" }) %>
          <% table.column(
            title: "Safety",
            html: ->(definition) {
              [
                definition.read_only ? "Read only" : "Writes",
                (", destructive" if definition.destructive),
                (", confirmation required" if definition.requires_confirmation)
              ].compact.join
            }
          ) %>
          <% table.column(
            title: "Calls today / 30 days",
            html: ->(definition) {
              key = [definition.key, definition.version]
              "#{@today_counts.fetch(key, 0)} / #{@thirty_day_counts.fetch(key, 0)}"
            }
          ) %>
          <% table.column(
            title: "Average / p95 duration",
            html: ->(definition) {
              key = [definition.key, definition.version]
              "#{admin_duration(@average_latency[key]&.round)} / #{admin_duration(@p95_latency[key])}"
            }
          ) %>
          <% table.column(
            title: "Outcomes",
            html: ->(definition) {
              @outcomes.select { |(tool_key, version, _), _| tool_key == definition.key && version == definition.version }.map { |(_, _, status), rate| "#{status}: #{number_to_percentage(rate * 100, precision: 1)}" }.join(", ").presence || "No calls"
            }
          ) %>
        <% end %>
      <% else %>
        <%= render FlatPack::EmptyState::Component.new(title: "No custom tools registered", description: "Registered tool definitions will appear here.") %>
      <% end %>
    <% end %>
  <% end %>
</div>
