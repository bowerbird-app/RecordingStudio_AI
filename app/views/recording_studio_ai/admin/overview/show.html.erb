<div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "AI administration", subtitle: "Execution health across the roots you can access.", variant: :h1) %>

  <% if @metrics[:breaches].any? %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(title: "Warnings", subtitle: "Deterministic thresholds exceeded in the last 24 hours.", variant: :h3, class: "mb-0 pb-0") %>
      <% end %>
      <% card.body do %>
        <div class="flex flex-wrap gap-2">
          <% @metrics[:breaches].each do |breach| %>
            <%= render FlatPack::Badge::Component.new(text: "#{breach[:metric].to_s.humanize}: #{breach[:value]}", style: :warning, size: :sm) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <% { "Runs today" => @run_counts[:today], "Runs / 7 days" => @run_counts[:seven_days], "Runs / 30 days" => @run_counts[:thirty_days], "Attempts / 24 hours" => @attempt_count, "Custom tools / 24 hours" => @tool_count, "Web search runs / 24 hours" => @web_search_count, "Batches / 24 hours" => @batch_count, "Batch items / 24 hours" => @batch_item_count }.each do |label, value| %>
      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.body do %>
          <p class="text-sm opacity-70"><%= label %></p>
          <p class="mt-2 text-2xl font-bold"><%= number_with_delimiter(value) %></p>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%= render FlatPack::PageTitle::Component.new(title: "Last 7 days", subtitle: "Runs, errors, tokens, spend, custom-tool calls, and batch items", variant: :h2) %>
  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    <% { "Runs" => :runs, "Errors" => :errors, "Tokens" => :tokens, "Spend#{" (#{@daily_spend_currency})" if @daily_spend_currency}" => :spend, "Custom-tool calls" => :tools, "Batch items" => :batch_items }.each do |title, key| %>
      <%= render FlatPack::Chart::Component.new(type: :column, title: title, height: 220, series: [{ name: title, data: @daily_activity.values.map { |values| values[key] } }], options: { xaxis: { categories: @daily_activity.keys.map { |date| date.strftime("%a %d") } } }) %>
    <% end %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Last 7 days", subtitle: "Runs, errors, tokens, spend, tools, and batch items", variant: :h3, class: "mb-0 pb-0") %><% end %>
      <% card.body do %>
        <div class="overflow-x-auto"><table class="w-full text-right text-sm"><thead><tr class="border-b"><th class="p-2 text-left">Day</th><th class="p-2">Runs</th><th class="p-2">Errors</th><th class="p-2">Tokens</th><th class="p-2">Spend μ</th><th class="p-2">Tools</th><th class="p-2">Batch items</th></tr></thead><tbody><% @daily_activity.each do |date, values| %><tr class="border-b"><td class="p-2 text-left"><%= date.strftime("%a %d") %></td><td class="p-2"><%= values[:runs] %></td><td class="p-2"><%= values[:errors] %></td><td class="p-2"><%= values[:tokens].nil? ? "Unknown" : values[:tokens] %></td><td class="p-2"><%= values[:spend].nil? ? "Unknown" : values[:spend] %></td><td class="p-2"><%= values[:tools] %></td><td class="p-2"><%= values[:batch_items] %></td></tr><% end %></tbody></table></div>
        <p class="mt-3 text-sm opacity-70">30-day p95 duration: <%= admin_duration(@p95_latency) %></p>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "24-hour metrics", subtitle: "Unknown means accounting was incomplete.", variant: :h3, class: "mb-0 pb-0") %><% end %>
      <% card.body do %>
        <dl class="grid grid-cols-2 gap-4 text-sm">
          <% @metrics[:values].each do |key, value| %>
            <div><dt class="opacity-70"><%= key.to_s.humanize %></dt><dd class="mt-1 font-semibold"><%= value.nil? ? "Unknown" : value %></dd></div>
          <% end %>
        </dl>
      <% end %>
    <% end %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <% { "Outcomes" => @outcomes, "Providers" => @providers, "Models" => @models, "Profiles" => @profiles, "Operations" => @operations, "Purposes" => @purposes, "Roots" => @roots, "Initiator types" => @initiators, "Executor types" => @executors, "Sources" => @sources, "Error categories" => @errors, "Custom-tool keys" => @tool_keys }.each do |title, values| %>
      <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
        <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: title, variant: :h3, class: "mb-0 pb-0") %><% end %>
        <% card.body do %>
          <% if values.any? %>
            <dl class="space-y-2 text-sm"><% values.sort_by { |key, _| key.to_s }.each do |key, value| %><div class="flex justify-between gap-4"><dt><%= Array(key).compact.join(" / ").presence || "Unknown" %></dt><dd class="font-semibold"><%= number_with_delimiter(value) %></dd></div><% end %></dl>
          <% else %><p class="text-sm opacity-70">No activity in this period.</p><% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Slow calls", subtitle: "Ten longest recorded runs", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %>
      <% if @slow_runs.any? %>
        <div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr class="border-b"><th class="p-3">Run</th><th class="p-3">Operation</th><th class="p-3">Provider / model</th><th class="p-3">Duration</th></tr></thead><tbody><% @slow_runs.each do |run| %><tr class="border-b"><td class="p-3"><%= link_to run.id, admin_run_path(run) %></td><td class="p-3"><%= run.operation %></td><td class="p-3"><%= [run.resolved_provider, run.resolved_model].compact.join(" / ").presence || "Unknown" %></td><td class="p-3"><%= admin_duration(run.latency_ms) %></td></tr><% end %></tbody></table></div>
      <% else %><p class="text-sm opacity-70">No duration data is available.</p><% end %>
    <% end %>
  <% end %>
</div>
