<div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Batch #{@batch.id}", subtitle: "#{@batch.provider} / #{@batch.model}", variant: :h1) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Batch details", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %><dl class="grid gap-4 text-sm md:grid-cols-3"><div><dt class="opacity-70">Status</dt><dd><%= render FlatPack::Badge::Component.new(text: @batch.status.humanize, style: admin_status_style(@batch.status), size: :sm) %></dd></div><div><dt class="opacity-70">Progress</dt><dd><%= @batch.completed_item_count %> completed / <%= @batch.failed_item_count %> failed / <%= @batch.cancelled_item_count %> cancelled / <%= @batch.item_count %> total</dd></div><div><dt class="opacity-70">Timing</dt><dd><%= @batch.submitted_at&.to_fs(:long) || "Not submitted" %> → <%= @batch.completed_at&.to_fs(:long) || "In progress" %></dd></div><div><dt class="opacity-70">Root / context</dt><dd><%= @batch.root_recording_id %> / <%= @batch.context_recording_id || "None" %></dd></div><div><dt class="opacity-70">Initiator</dt><dd><%= admin_identity(@batch.initiator_type, @batch.initiator_id, @sensitive ? @batch.initiator_snapshot : nil) %></dd></div><div><dt class="opacity-70">Executor</dt><dd><%= admin_identity(@batch.executor_type, @batch.executor_id, @sensitive ? @batch.executor_snapshot : nil) %></dd></div><div><dt class="opacity-70">Impersonator</dt><dd><%= admin_identity(@batch.impersonator_type, @batch.impersonator_id, @sensitive ? @batch.impersonator_snapshot : nil) %></dd></div><div><dt class="opacity-70">Execution source</dt><dd><%= @batch.execution_source.presence || "Unknown" %></dd></div><div><dt class="opacity-70">Usage</dt><dd><%= admin_tokens(@batch.total_tokens) %> tokens</dd></div><div><dt class="opacity-70">Cost / expiry</dt><dd><%= admin_cost(@batch.cost_amount_microunits, @batch.cost_currency, @batch.cost_estimated) %> / <%= @batch.expires_at&.to_fs(:long) || "Unknown" %></dd></div>
      <% if @sensitive %><div><dt class="opacity-70">Provider ID</dt><dd class="break-all"><%= @batch.provider_batch_id.presence || "None" %></dd></div><div><dt class="opacity-70">Request / job IDs</dt><dd><%= [@batch.request_id, @batch.job_id].compact.join(" / ").presence || "None" %></dd></div><div><dt class="opacity-70">Error</dt><dd><%= [@batch.error_category, @batch.error_code, @batch.error_message].compact.join(": ").presence || "None" %></dd></div><div class="md:col-span-3"><dt class="opacity-70">Metadata</dt><dd><pre class="mt-1 overflow-auto whitespace-pre-wrap text-xs"><%= admin_json(@batch.metadata) %></pre></dd></div><% end %>
    </dl><% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.header do %><%= render FlatPack::PageTitle::Component.new(title: "Items", subtitle: "Position, linked run, provider outcome, accounting, and retained response", variant: :h3, class: "mb-0 pb-0") %><% end %>
    <% card.body do %><% if @items.any? %><div class="overflow-x-auto"><table class="w-full min-w-max text-left text-sm"><thead><tr class="border-b"><th class="p-3">Position / reference</th><th class="p-3">Run / provider item</th><th class="p-3">Status</th><th class="p-3">Timing</th><th class="p-3">Usage / cost</th><th class="p-3">Finish / error</th><th class="p-3">Response</th></tr></thead><tbody><% @items.each do |item| %><tr class="border-b align-top"><td class="p-3"><%= item.position %> / <%= item.reference %></td><td class="p-3"><%= link_to "Run #{item.run_id}", admin_run_path(item.run_id) %><% if @sensitive && item.provider_item_id.present? %><div class="text-xs opacity-70"><%= item.provider_item_id %></div><% end %></td><td class="p-3"><%= render FlatPack::Badge::Component.new(text: item.status.humanize, style: admin_status_style(item.status), size: :sm) %></td><td class="p-3"><%= item.started_at&.to_fs(:short) || "Unknown" %> → <%= item.completed_at&.to_fs(:short) || "In progress" %></td><td class="p-3"><%= admin_tokens(item.total_tokens) %> / <%= admin_cost(item.cost_amount_microunits, item.cost_currency, item.cost_estimated) %></td><td class="p-3"><%= item.finish_reason.presence || "Unknown" %><% if @sensitive && item.error_code.present? %><div class="text-xs"><%= [item.error_code, item.error_message].compact.join(": ") %></div><% end %></td><td class="p-3"><% if item.response.nil? %>Response content was not retained for this execution.<% elsif @sensitive %><%= link_to "View retained response", admin_retained_response_path(item.response) %><% else %>Retained response is restricted.<% end %></td></tr><% end %></tbody></table></div><% else %><p class="text-sm opacity-70">No batch items were recorded.</p><% end %><% end %>
  <% end %>
</div>
