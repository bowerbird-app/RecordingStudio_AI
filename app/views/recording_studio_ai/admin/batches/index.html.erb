<div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Provider batches", subtitle: "Review recorded provider batch executions.") %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <% if @batches.any? %>
        <%= render FlatPack::Table::Component.new(data: @batches) do |table| %>
          <% table.column(
            title: "Time / ID",
            html: ->(batch) {
              details = ["Batch #{batch.id}"]
              details << "Provider batch #{batch.provider_batch_id.presence || 'none'}" if @sensitive_roots[batch.root_recording_id]
              safe_join([
                link_to(batch.created_at.to_fs(:short), admin_batch_path(batch), class: "font-semibold"),
                content_tag(:div, safe_join(details, tag.br), class: "text-xs opacity-70")
              ])
            }
          ) %>
          <% table.column(
            title: "Attribution",
            html: ->(batch) {
              safe_join([
                "Root #{batch.root_recording_id}",
                content_tag(:div, "#{batch.initiator_type} ##{batch.initiator_id}", class: "text-xs opacity-70")
              ])
            }
          ) %>
          <% table.column(
            title: "Provider / model",
            html: ->(batch) {
              safe_join([
                [batch.provider, batch.model].compact.join(" / ").presence || "Unknown",
                content_tag(:div, batch.profile_key.presence || "No profile", class: "text-xs opacity-70")
              ])
            }
          ) %>
          <% table.column(
            title: "Status",
            html: ->(batch) { render FlatPack::Badge::Component.new(text: batch.status.humanize, style: admin_status_style(batch.status), size: :sm) }
          ) %>
          <% table.column(
            title: "Progress",
            html: ->(batch) {
              safe_join([
                "#{batch.completed_item_count + batch.failed_item_count + batch.cancelled_item_count} / #{batch.item_count}",
                content_tag(:div, "#{batch.failed_item_count} failed; #{batch.cancelled_item_count} cancelled", class: "text-xs opacity-70")
              ])
            }
          ) %>
          <% table.column(title: "Usage / cost", html: ->(batch) { admin_tokens(batch.total_tokens) }) %>
          <% table.column(title: "Expiry", html: ->(batch) { batch.expires_at&.to_fs(:short) || "Unknown" }) %>
        <% end %>
      <% else %>
        <%= render FlatPack::EmptyState::Component.new(title: "No batches found", description: "Submitted provider batches will appear here.") %>
      <% end %>
    <% end %>
  <% end %>
</div>
