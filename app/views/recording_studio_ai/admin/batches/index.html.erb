<div class="mx-auto flex w-full max-w-7xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(title: "Provider batches", subtitle: "Review recorded provider batch executions.") %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <% if @batches.any? %>
        <%= render FlatPack::Table::Component.new(data: @batches) do |table| %>
          <% table.column(title: "Time / ID") do |batch| %>
            <div>
              <%= link_to batch.created_at.to_fs(:short), admin_batch_path(batch), class: "font-semibold" %>
              <div class="text-xs opacity-70">
                Batch <%= batch.id %>
                <% if @sensitive_roots[batch.root_recording_id] %>
                  <br>Provider batch <%= batch.provider_batch_id.presence || "none" %>
                <% end %>
              </div>
            </div>
          <% end %>
          <% table.column(title: "Attribution") do |batch| %>
            <div>
              Root <%= batch.root_recording_id %>
              <div class="text-xs opacity-70"><%= batch.initiator_type %> #<%= batch.initiator_id %></div>
            </div>
          <% end %>
          <% table.column(title: "Provider / model") do |batch| %>
            <div>
              <%= [batch.provider, batch.model].compact.join(" / ").presence || "Unknown" %>
              <div class="text-xs opacity-70"><%= batch.profile_key.presence || "No profile" %></div>
            </div>
          <% end %>
          <% table.column(title: "Status") do |batch| %>
            <%= render FlatPack::Badge::Component.new(text: batch.status.humanize, style: admin_status_style(batch.status), size: :sm) %>
          <% end %>
          <% table.column(title: "Progress") do |batch| %>
            <div>
              <%= batch.completed_item_count + batch.failed_item_count + batch.cancelled_item_count %> / <%= batch.item_count %>
              <div class="text-xs opacity-70"><%= batch.failed_item_count %> failed; <%= batch.cancelled_item_count %> cancelled</div>
            </div>
          <% end %>
          <% table.column(title: "Usage / cost") { |batch| admin_tokens(batch.total_tokens) } %>
          <% table.column(title: "Expiry") { |batch| batch.expires_at&.to_fs(:short) || "Unknown" } %>
        <% end %>
      <% else %>
        <%= render FlatPack::EmptyState::Component.new(title: "No batches found", description: "Submitted provider batches will appear here.") %>
      <% end %>
    <% end %>
  <% end %>
</div>
