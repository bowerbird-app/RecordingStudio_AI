<div class="mx-auto flex w-full max-w-7xl flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Tables",
    subtitle: "Persistence schema reference for Recording Studio AI.",
    variant: :h1
  ) %>

  <div class="space-y-2 text-sm leading-6 text-(--surface-muted-content-color)">
    <p>
      This page documents every persistence table introduced by this gem.
      For each column, you get a realistic sample value and a high-level explanation of what role that field plays.
    </p>
    <p>
      Use this as an implementation map when wiring analytics, retention policies, admin reporting,
      data backfills, and incident debugging workflows.
    </p>
  </div>

  <% @tables.each do |table| %>
    <section class="space-y-3">
      <%= render FlatPack::PageTitle::Component.new(
        title: table[:name],
        subtitle: table[:purpose],
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>

      <%= render FlatPack::Table::Component.new(data: table[:columns]) do |flatpack_table| %>
        <% flatpack_table.column(title: "Column") do |column| %>
          <span class="font-mono text-xs"><%= column[:name] %></span>
        <% end %>
        <% flatpack_table.column(title: "Type") { |column| column[:type] } %>
        <% flatpack_table.column(title: "Required") { |column| column[:required] ? "Yes" : "No" } %>
        <% flatpack_table.column(title: "Sample data") do |column| %>
          <span class="font-mono text-xs"><%= column[:sample] %></span>
        <% end %>
        <% flatpack_table.column(title: "High-level explanation") { |column| column[:explanation] } %>
      <% end %>
    </section>
  <% end %>
</div>