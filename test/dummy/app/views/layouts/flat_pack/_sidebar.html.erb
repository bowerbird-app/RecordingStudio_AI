<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "AI",
      title: "Recording Studio AI",
      subtitle: "Phase 1 foundation"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-1" aria-label="Main navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "AI Admin",
        href: "/admin",
        icon: :dashboard
      ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "AI Responses",
        href: "/admin/screens/recording_studio_ai_responses",
        icon: :table
      ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Recording tree",
        href: main_app.recording_tree_path,
        icon: :folder
      ) %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "AI playground",
        href: main_app.ai_playground_path,
        icon: :cpu_chip
      ) %>
    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-(--surface-muted-content-color)") do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Sign out",
        href: main_app.destroy_user_session_path,
        icon: :lock,
        class: "mx-0",
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
