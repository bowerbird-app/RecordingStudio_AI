<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "AI Playground",
    subtitle: "Test RecordingStudioAI generation, streaming, web search, tool calls, and provider batch execution.",
    variant: :h1
  ) %>

  <div class="flex items-center gap-3">
    <%= render FlatPack::Button::Component.new(
      text: "AI Responses",
      url: "/admin/screens/recording_studio_ai_responses",
      style: :secondary,
      size: :sm
    ) %>
  </div>

  <%= render FlatPack::Tabs::Component.new(default_tab: 0, variant: :pills) do |tabs| %>
    <% tabs.tab(label: "Chat", id: "chat") do %>
      <%= form_with url: main_app.ai_playground_path, method: :post, scope: :ai_playground, local: true, data: { turbo: false }, class: "space-y-4" do %>
        <%= hidden_field_tag "ai_playground[capability]", "chat" %>
        <%= hidden_field_tag "ai_playground[web_search]", "0" %>

        <%= render FlatPack::Select::Component.new(
          name: "ai_playground[provider]",
          label: "Provider",
          options: @provider_options,
          value: @form.fetch("provider")
        ) %>
        <%= render FlatPack::Select::Component.new(
          name: "ai_playground[profile]",
          label: "Profile",
          options: @profile_options,
          value: @form.fetch("profile")
        ) %>
        <%= render FlatPack::TextArea::Component.new(
          name: "ai_playground[prompt]",
          label: "Prompt",
          value: @form.fetch("prompt"),
          rows: 5,
          required: true
        ) %>
        <%= render FlatPack::Checkbox::Component.new(
          name: "ai_playground[web_search]",
          label: "Enable web search",
          checked: @form.fetch("web_search", "0") == "1"
        ) %>
        <%= button_tag "Run Chat", type: "submit", class: "inline-flex items-center justify-center rounded-[var(--button-border-radius)] bg-[var(--button-primary-background-color)] px-[var(--button-padding-x-md)] py-[var(--button-padding-y-md)] text-sm font-medium text-[var(--button-primary-text-color)]" %>
      <% end %>
    <% end %>

    <% tabs.tab(label: "Streaming", id: "streaming") do %>
      <%= form_with url: main_app.ai_playground_path, method: :post, scope: :ai_playground, local: true, data: { turbo: false }, class: "space-y-4" do %>
        <%= hidden_field_tag "ai_playground[capability]", "streaming" %>
        <%= hidden_field_tag "ai_playground[web_search]", "0" %>

        <%= render FlatPack::Select::Component.new(name: "ai_playground[provider]", label: "Provider", options: @provider_options, value: @form.fetch("provider")) %>
        <%= render FlatPack::Select::Component.new(name: "ai_playground[profile]", label: "Profile", options: @profile_options, value: @form.fetch("profile")) %>
        <%= render FlatPack::TextArea::Component.new(name: "ai_playground[prompt]", label: "Prompt", value: @form.fetch("prompt"), rows: 5, required: true) %>
        <%= render FlatPack::Checkbox::Component.new(name: "ai_playground[web_search]", label: "Enable web search", checked: @form.fetch("web_search", "0") == "1") %>
        <%= button_tag "Run Streaming", type: "submit", class: "inline-flex items-center justify-center rounded-[var(--button-border-radius)] bg-[var(--button-primary-background-color)] px-[var(--button-padding-x-md)] py-[var(--button-padding-y-md)] text-sm font-medium text-[var(--button-primary-text-color)]" %>
      <% end %>
    <% end %>

    <% tabs.tab(label: "Tool Calls", id: "tool_calls") do %>
      <%= form_with url: main_app.ai_playground_path, method: :post, scope: :ai_playground, local: true, data: { turbo: false }, class: "space-y-4" do %>
        <%= hidden_field_tag "ai_playground[capability]", "tool_calls" %>
        <%= hidden_field_tag "ai_playground[web_search]", "0" %>

        <%= render FlatPack::Select::Component.new(name: "ai_playground[provider]", label: "Provider", options: @provider_options, value: @form.fetch("provider")) %>
        <%= render FlatPack::Select::Component.new(name: "ai_playground[profile]", label: "Profile", options: @profile_options, value: @form.fetch("profile")) %>
        <%= render FlatPack::TextArea::Component.new(name: "ai_playground[prompt]", label: "Prompt", value: @form.fetch("prompt"), rows: 5, required: true) %>
        <%= render FlatPack::Checkbox::Component.new(name: "ai_playground[web_search]", label: "Enable web search", checked: @form.fetch("web_search", "0") == "1") %>
        <%= button_tag "Run Tool Calls", type: "submit", class: "inline-flex items-center justify-center rounded-[var(--button-border-radius)] bg-[var(--button-primary-background-color)] px-[var(--button-padding-x-md)] py-[var(--button-padding-y-md)] text-sm font-medium text-[var(--button-primary-text-color)]" %>
      <% end %>
    <% end %>

    <% tabs.tab(label: "Batch", id: "batch") do %>
      <%= form_with url: main_app.ai_playground_path, method: :post, scope: :ai_playground, local: true, data: { turbo: false }, class: "space-y-4" do %>
        <%= hidden_field_tag "ai_playground[capability]", "batch_calls" %>
        <%= hidden_field_tag "ai_playground[web_search]", "0" %>

        <%= render FlatPack::Select::Component.new(name: "ai_playground[provider]", label: "Provider", options: @provider_options, value: @form.fetch("provider")) %>
        <%= render FlatPack::Select::Component.new(name: "ai_playground[profile]", label: "Profile", options: @profile_options, value: @form.fetch("profile")) %>
        <%= render FlatPack::TextArea::Component.new(name: "ai_playground[prompt]", label: "Prompt", value: @form.fetch("prompt"), rows: 5, required: true) %>
        <%= render FlatPack::Checkbox::Component.new(name: "ai_playground[web_search]", label: "Enable web search", checked: @form.fetch("web_search", "0") == "1") %>
        <%= button_tag "Run Batch", type: "submit", class: "inline-flex items-center justify-center rounded-[var(--button-border-radius)] bg-[var(--button-primary-background-color)] px-[var(--button-padding-x-md)] py-[var(--button-padding-y-md)] text-sm font-medium text-[var(--button-primary-text-color)]" %>
      <% end %>
    <% end %>
  <% end %>

  <% if @error_message.present? %>
    <div class="space-y-2">
      <h3 class="text-xl font-semibold text-(--color-danger-background-color)">Execution error</h3>
      <p class="text-sm"><%= @error_message %></p>
    </div>
  <% end %>

  <% if @response_payload.present? %>
    <div class="space-y-3">
      <h3 class="text-xl font-semibold">Execution result</h3>
      <% if @request_id.present? %>
        <p class="text-sm text-(--surface-muted-content-color)">Request ID: <%= @request_id %></p>
      <% end %>

      <% if @stream_text.present? %>
        <div class="space-y-2">
          <h4 class="text-sm font-semibold">Streamed text</h4>
          <p class="text-sm whitespace-pre-wrap"><%= @stream_text %></p>
        </div>
      <% end %>

      <% if @stream_events.present? %>
        <div class="space-y-2">
          <h4 class="text-sm font-semibold">Stream events</h4>
          <pre class="overflow-auto rounded-md border border-(--surface-border-color) p-3 text-xs"><%= JSON.pretty_generate(@stream_events) %></pre>
        </div>
      <% end %>

      <div class="space-y-2">
        <h4 class="text-sm font-semibold">Response JSON</h4>
        <pre class="overflow-auto rounded-md border border-(--surface-border-color) p-3 text-xs"><%= JSON.pretty_generate(@response_payload) %></pre>
      </div>
    </div>
  <% end %>

  <% if @created_runs.present? %>
    <div class="space-y-3">
      <h3 class="text-xl font-semibold">Created runs</h3>
      <%= render FlatPack::List::Component.new(divider: true) do %>
        <% @created_runs.each do |run| %>
          <%= render FlatPack::List::Item.new(icon: :cpu_chip) do %>
            <div class="flex flex-col gap-1">
              <span class="text-sm font-medium">Run <%= run.id %> • <%= run.operation %> • <%= run.status %></span>
              <span class="text-xs text-(--surface-muted-content-color)">Provider: <%= run.resolved_provider || "n/a" %> • Model: <%= run.resolved_model || "n/a" %></span>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @created_attempts.present? %>
    <div class="space-y-3">
      <h3 class="text-xl font-semibold">Created attempts</h3>
      <%= render FlatPack::List::Component.new(divider: true) do %>
        <% @created_attempts.each do |attempt| %>
          <%= render FlatPack::List::Item.new(icon: :clock) do %>
            <div class="flex flex-col gap-1">
              <span class="text-sm font-medium">Attempt <%= attempt.id %> • seq <%= attempt.sequence %> • <%= attempt.status %></span>
              <span class="text-xs text-(--surface-muted-content-color)">Provider: <%= attempt.provider || "n/a" %> • Model: <%= attempt.model || "n/a" %></span>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
