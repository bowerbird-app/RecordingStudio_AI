<div class="mx-auto flex w-full max-w-6xl flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Use Recording Studio AI from application services, controllers, jobs, and workflows.",
    variant: :h1
  ) %>

  <section class="space-y-3">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Shared Attribution",
      subtitle: "Every operation requires a root recording and initiator. Add context, executor, and request metadata when available.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Request context",
      language: "ruby",
      code: <<~'RUBY'
        root_recording = workspace.root_recording

        attribution = {
          root_recording: root_recording,
          context_recording: page.recording,
          initiator: current_user,
          initiator_kind: :user,
          execution_source: :web,
          request_id: request.request_id
        }
      RUBY
    ) %>
  </section>

  <section class="space-y-3">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Generate",
      subtitle: "One entry point for sync and streaming generation. Pass stream: true to receive incremental events. Optional model and flat generation parameters are validated against the model registry.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Synchronous generation",
      language: "ruby",
      code: <<~'RUBY'
        response = RecordingStudioAI.generate(
          prompt: "Summarize this page for an editor.",
          purpose: "page_summary",
          profile: :medium,
          provider: :openai,
          model: "gpt-5",
          temperature: 0.4,
          verbosity: "medium",
          provider_native_tools: [:web_search],
          metadata: { feature: "page_editor" },
          **attribution
        )

        if response.success?
          response.text
        else
          Rails.logger.warn(response.error.message)
        end

        # Use generate! when a failed generation should raise RecordingStudioAI::Errors::ExecutionError.
        response = RecordingStudioAI.generate!(prompt: "Draft a title", **attribution)
      RUBY
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Explicit fallbacks",
      language: "ruby",
      code: <<~'RUBY'
        # Skip configured profiles for this call. Hop the list in order.
        # Do not combine fallbacks: with provider: or model:.
        # Top-level caller params travel to the next hop when that model supports them.
        # Entry overlays (e.g. temperature on a hop) apply only when the caller omitted them.
        response = RecordingStudioAI.generate(
          prompt: "Summarize this page for an editor.",
          purpose: "page_summary",
          temperature: 1,
          fallbacks: [
            { provider: :openai, model: "gpt-5-mini" },
            { provider: :gemini, model: "gemini-2.5-flash", max_output_tokens: 2048 }
          ],
          **attribution
        )
      RUBY
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Streaming generation",
      language: "ruby",
      code: <<~'RUBY'
        RecordingStudioAI.generate(
          prompt: "Explain this report in three bullets.",
          purpose: "report_explanation",
          stream: true,
          **attribution
        ) do |event|
          next unless event.type == "content_delta"

          broadcast_append_to("generation_#{current_user.id}", target: "output", html: event.text)
        end

        # Without a block, stream: true returns an Enumerator.
        events = RecordingStudioAI.generate(prompt: "Draft an outline", stream: true, **attribution)
        events.each { |event| process_event(event) }
      RUBY
    ) %>
  </section>

  <section class="space-y-3">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Batch",
      subtitle: "Submit independent items to a provider batch, then refresh synchronously or enqueue polling with Sidekiq through ActiveJob. Batch stays on submit_batch — it is not part of generate.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Submit and poll a batch",
      language: "ruby",
      code: <<~'RUBY'
        batch = RecordingStudioAI.submit_batch(
          purpose: "nightly_page_summaries",
          profile: :medium,
          model: "gpt-5-mini",
          items: pages.map do |page|
            {
              reference: page.id.to_s,
              prompt: "Summarize #{page.title}.",
              purpose: "page_summary",
              metadata: { page_id: page.id }
            }
          end,
          **attribution
        )

        # Fetch the provider's latest status in the current process.
        RecordingStudioAI.refresh_batch(batch_id: batch.batch.id, **attribution)

        # Enqueue polling. The configured batch_synchronization_job reschedules
        # itself until the batch reaches a terminal status.
        RecordingStudioAI.refresh_batch_async(batch_id: batch.batch.id, **attribution)

        RecordingStudioAI.cancel_batch(batch_id: batch.batch.id, **attribution)
      RUBY
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Wake refresh from a webhook",
      language: "ruby",
      code: <<~'RUBY'
        # Optional. Requires recording_studio_webhooks plus the OpenAI recipes on /config.
        # Looks up the batch by provider_batch_id under the root, then runs refresh_batch.
        # Never trusts webhook payload status or results — always retrieves from the provider.
        RecordingStudioAI.refresh_batch_from_webhook(
          provider_batch_id: "batch_abc123",
          root_recording: root_recording,
          request_id: "evt_123"
        )
      RUBY
    ) %>
  </section>

  <section class="space-y-3">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Models",
      subtitle: "Register provider models declaratively, then reference them by their provider API model string in profiles. Query the registry to inspect what a model supports.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Register and query models",
      language: "ruby",
      code: <<~'RUBY'
        # Register a model (built-ins live under lib/recording_studio_ai/models/<provider>/<key>.rb).
        RecordingStudioAI.models.register(
          provider: :openai,
          key: "gpt-5",
          model: "gpt-5",
          display_name: "GPT-5",
          delivery: { streaming: true, structured_output: true, batch: true, batch_cancellation: true },
          parameters: {
            temperature:       { type: :number, min: 0.0, max: 2.0, default: 1.0, step: 0.1 },
            verbosity:         { type: :string, values: %w[low medium high], default: "medium" },
            max_output_tokens: { type: :integer, min: 1, max: 128_000, default: 8_192 },
            reasoning_effort:  { type: :string, values: %w[minimal low medium high], default: "medium" }
          },
          tools: %i[web_search file_search code_execution image_generation custom_tools],
          modalities: { input: %i[text image file], output: %i[text] }
        )

        # Inspect a model (used by the resolver and the AI playground).
        model = RecordingStudioAI.models.fetch(:openai, "gpt-5")
        model.capabilities            # => [:generation, :streaming, :structured_output, ...]
        model.supports_parameter?(:temperature)   # => true
        model.parameter(:temperature)             # => { type: :number, min: 0.0, max: 2.0, ... }
        model.supports_tool?(:web_search)         # => true
        model.modalities                          # => { input: [:text, :image, :file], output: [:text] }

        RecordingStudioAI.models.for_provider(:openai)  # all OpenAI models
        RecordingStudioAI.models.all                    # every registered model
      RUBY
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Override a model",
      language: "ruby",
      code: <<~'RUBY'
        # Same provider + key. Without override: true, a duplicate registration raises.
        RecordingStudioAI.models.register(
          provider: :openai,
          key: "gpt-5",
          model: "gpt-5",
          override: true,
          display_name: "GPT-5 (host)",
          delivery: { streaming: true, structured_output: true, batch: true, batch_cancellation: true },
          parameters: {
            temperature: { type: :number, min: 0.0, max: 2.0, default: 1.0, step: 0.1 },
            max_output_tokens: { type: :integer, min: 1, max: 128_000, default: 4_096 }
          },
          tools: %i[web_search custom_tools],
          modalities: { input: %i[text], output: %i[text] }
        )
      RUBY
    ) %>
  </section>

  <section class="space-y-3">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Custom Tools",
      subtitle: "Register a tool, optionally override the same key and version, then pass the reference to generate. Streaming uses the same call with stream: true.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Register a tool",
      language: "ruby",
      code: <<~'RUBY'
        RecordingStudioAI.tools.register(
          key: "lookup_project",
          version: 1,
          name: "Lookup Project",
          description: "Returns the latest status for a project.",
          use_when: "You need project-level status.",
          do_not_use_when: "No project id is available.",
          parameters: [
            { name: "project_id", type: "string", required: true, description: "Project identifier" }
          ],
          returns: "A hash with status and summary.",
          cost: "low",
          latency: "fast",
          read_only: true,
          destructive: false,
          requires_confirmation: false,
          idempotent: true,
          executor_label: "Host",
          executor: ->(arguments, _context) do
            { project_id: arguments.fetch("project_id"), status: "on_track" }
          end
        )
      RUBY
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Override a tool",
      language: "ruby",
      code: <<~'RUBY'
        # Same key + version. Without override: true, a duplicate registration raises.
        RecordingStudioAI.tools.register(
          key: "lookup_project",
          version: 1,
          override: true,
          name: "Lookup Project",
          description: "Host override of the project lookup tool.",
          use_when: "You need project-level status.",
          do_not_use_when: "No project id is available.",
          parameters: [
            { name: "project_id", type: "string", required: true, description: "Project identifier" }
          ],
          returns: "A hash with status and summary.",
          cost: "low",
          latency: "fast",
          read_only: true,
          destructive: false,
          requires_confirmation: false,
          idempotent: true,
          executor_label: "Host",
          executor: ->(arguments, _context) do
            { project_id: arguments.fetch("project_id"), status: "at_risk" }
          end
        )
      RUBY
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Tool-enabled generation",
      language: "ruby",
      code: <<~'RUBY'
        response = RecordingStudioAI.generate(
          prompt: "Find the latest project status.",
          purpose: "project_status",
          custom_tools: [{ key: "lookup_project", version: 1 }],
          **attribution
        )
      RUBY
    ) %>
  </section>

  <section class="space-y-3">
    <%= render FlatPack::PageTitle::Component.new(
      title: "Prompts",
      subtitle: "Register versioned message templates, call them by key, and override the same key and version when the existing prompt allows it.",
      variant: :h3,
      class: "mb-0 pb-0"
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Register a prompt",
      language: "ruby",
      code: <<~'RUBY'
        # owner is who registered the prompt (PascalCase label), not an actor.
        # overridable: true is the default — later override attempts are allowed.
        RecordingStudioAI.prompts.register(
          owner: "SupportGem",
          key: :customer_reply,
          version: 1,
          name: "Customer Support Reply",
          description: "Creates a concise response to a customer message.",
          overridable: true,
          inputs: %i[customer_name message],
          messages: [
            { role: :system, content: "Write a concise, helpful customer response." },
            { role: :user, content: "{{customer_name}}: {{message}}" }
          ],
          defaults: { profile: :medium, purpose: "customer_reply" }
        )

        # Lock a key+version so hosts or later gems cannot replace it:
        RecordingStudioAI.prompts.register(
          owner: "RecordingStudioAI",
          key: :billing_escalation,
          version: 1,
          name: "Billing Escalation",
          description: "Fixed wording for billing escalations.",
          overridable: false,
          inputs: %i[account_id],
          messages: [
            { role: :system, content: "Escalate billing issues with the required disclaimer." },
            { role: :user, content: "Account {{account_id}}" }
          ]
        )
      RUBY
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Call a prompt",
      language: "ruby",
      code: <<~'RUBY'
        RecordingStudioAI.prompt(:customer_reply).call(
          inputs: { customer_name: customer.name, message: message.body },
          **attribution
        )
      RUBY
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Override a prompt",
      language: "ruby",
      code: <<~'RUBY'
        # Same key + version. Requires override: true, and the existing registration
        # must have overridable: true (the default).
        RecordingStudioAI.prompts.register(
          owner: "Host",
          key: :customer_reply,
          version: 1,
          override: true,
          name: "Host Customer Reply",
          description: "Our in-house tone for customer replies.",
          overridable: true,
          inputs: %i[customer_name message],
          messages: [
            { role: :system, content: "Be brief, warm, and specific. No filler." },
            { role: :user, content: "{{customer_name}}: {{message}}" }
          ],
          defaults: { profile: :medium, purpose: "customer_reply" }
        )
      RUBY
    ) %>
  </section>
</div>
