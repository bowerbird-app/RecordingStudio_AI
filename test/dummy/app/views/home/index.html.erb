<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio AI",
    subtitle: "Synchronous provider execution inside a Recording Studio host.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Foundation ready",
          subtitle: "The addon loads without adding application data.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>The <code>RecordingStudioAI</code> namespace is loaded.</li>
          <li>The isolated engine is mounted at <code>/recording_studio_ai</code>.</li>
          <li>OpenAI or Gemini credentials can be supplied without selecting a provider.</li>
          <li>Addon migrations install six execution infrastructure tables.</li>
        </ul>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Recording Studio integration",
          subtitle: "The host remains the integration boundary.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Strict v3 recordable declarations are enabled.</li>
          <li>Authenticated users are assigned to <code>Current.actor</code>.</li>
          <li>Workspace, folder, and page records exercise root and child recordings.</li>
          <li>Synchronous generation resolves OpenAI or Gemini through shared contracts.</li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
