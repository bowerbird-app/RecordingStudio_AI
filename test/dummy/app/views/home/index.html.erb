<% recording_studio_page_nav(title: "Recording Studio AI", page_nav_anchor_url: root_path) %>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio AI",
    subtitle: "Generate, inspect configuration, and review AI activity in this host.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <%= render FlatPack::Button::Component.new(text: "Playground", href: main_app.ai_playground_path, style: :primary, size: :sm) %>
    <%= render FlatPack::Button::Component.new(text: "Config", href: main_app.gem_config_path, style: :secondary, size: :sm) %>
    <%= render FlatPack::Button::Component.new(text: "Methods", href: main_app.gem_methods_path, style: :secondary, size: :sm) %>
    <%= render FlatPack::Button::Component.new(text: "AI administration", href: "/recording_studio_ai/admin", style: :secondary, size: :sm) %>
